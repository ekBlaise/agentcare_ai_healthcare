# ===================================================================
# AgentCare - Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# ===================================================================

# -- LLM (Groq - free tier at https://console.groq.com) --------------
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# -- Database ---------------------------------------------------------
# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./data/agentcare.db
# PostgreSQL / Neon (uncomment and use instead for production):
# DATABASE_URL=postgresql+psycopg2://user:password@host/dbname

# -- Auth -------------------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# -- App --------------------------------------------------------------
APP_ENV=development
UPLOAD_DIR=./app/uploads
LOG_LEVEL=INFO

# -- Safety -----------------------------------------------------------
# Comma-separated keywords that force an emergency escalation
EMERGENCY_KEYWORDS=chest pain,stroke,bleeding,unconscious,suicide,overdose,can't breathe,heart attack